import {
  useEffect,
  useMemo,
  useState,
} from "react";

import type {
  Session,
} from "@supabase/supabase-js";

import {
  supabase,
} from "./lib/supabase";

import "./ProfileSetup.css";
import campfireIcon from "./assets/campfire-icon.png";

export type CampfireProfile = {
  id: string;
  username: string | null;
  display_name: string | null;
  avatar_url: string | null;
  status: string;
};

type Props = {
  session: Session;
  profile: CampfireProfile;
  onComplete: (
    profile: CampfireProfile
  ) => void;
};

type UsernameState =
  | "idle"
  | "checking"
  | "available"
  | "taken"
  | "error";

const usernameRegex =
  /^[a-z0-9_]{3,24}$/;

function ProfileSetup({
  session,
  profile,
  onComplete,
}: Props) {
  /*
   * =========================================================
   * DADOS INICIAIS VINDOS DO GOOGLE
   * =========================================================
   */

  const googleName =
    session.user.user_metadata
      ?.full_name ||
    session.user.user_metadata
      ?.name ||
    "";

  const googleAvatar =
    session.user.user_metadata
      ?.avatar_url ||
    session.user.user_metadata
      ?.picture ||
    null;

  /*
   * =========================================================
   * FORMULÁRIO
   * =========================================================
   */

  const [username, setUsername] =
    useState(
      profile.username || ""
    );

  const [
    displayName,
    setDisplayName,
  ] =
    useState(
      profile.display_name ||
      googleName ||
      ""
    );

  const [
    usernameState,
    setUsernameState,
  ] =
    useState<UsernameState>(
      "idle"
    );

  const [
    saving,
    setSaving,
  ] =
    useState(false);

  const [
    errorMessage,
    setErrorMessage,
  ] =
    useState("");

  /*
   * =========================================================
   * USERNAME NORMALIZADO
   * =========================================================
   */

  const cleanUsername =
    useMemo(
      () =>
        username
          .trim()
          .toLowerCase(),
      [username]
    );

  const usernameValid =
    usernameRegex.test(
      cleanUsername
    );

  /*
   * =========================================================
   * VERIFICAR DISPONIBILIDADE
   * =========================================================
   */

  useEffect(() => {
    let cancelled = false;

    if (!usernameValid) {
      setUsernameState(
        "idle"
      );

      return;
    }

    setUsernameState(
      "checking"
    );

    const timer =
      window.setTimeout(
        async () => {
          const {
            data,
            error,
          } =
            await supabase
              .from("profiles")
              .select("id")
              .eq(
                "username",
                cleanUsername
              )
              .neq(
                "id",
                session.user.id
              )
              .maybeSingle();

          if (cancelled) {
            return;
          }

          if (error) {
            console.error(
              "Erro verificando username:",
              error
            );

            setUsernameState(
              "error"
            );

            return;
          }

          setUsernameState(
            data
              ? "taken"
              : "available"
          );
        },
        450
      );

    return () => {
      cancelled = true;

      window.clearTimeout(
        timer
      );
    };
  }, [
    cleanUsername,
    usernameValid,
    session.user.id,
  ]);

  /*
   * =========================================================
   * SALVAR PERFIL
   * =========================================================
   */

  async function saveProfile() {
    if (!usernameValid) {
      setErrorMessage(
        "Escolha um username válido."
      );

      return;
    }

    if (
      usernameState ===
      "taken"
    ) {
      setErrorMessage(
        "Esse username já está em uso."
      );

      return;
    }

    if (
      usernameState ===
      "checking"
    ) {
      return;
    }

    setSaving(true);
    setErrorMessage("");

    const finalDisplayName =
      displayName
        .trim()
        .slice(0, 40) ||
      cleanUsername;

    const finalAvatar =
      profile.avatar_url ||
      googleAvatar ||
      null;

    try {
      const {
        data,
        error,
      } =
        await supabase
          .from("profiles")
          .upsert(
            {
              id:
                session.user.id,

              username:
                cleanUsername,

              display_name:
                finalDisplayName,

              avatar_url:
                finalAvatar,

              status:
                "online",
            },
            {
              onConflict:
                "id",
            }
          )
          .select(
            `
              id,
              username,
              display_name,
              avatar_url,
              status
            `
          )
          .single();

      if (error) {
        /*
         * PostgreSQL:
         * unique_violation
         */
        if (
          error.code ===
          "23505"
        ) {
          setUsernameState(
            "taken"
          );

          throw new Error(
            "Esse username acabou de ser registrado por outra pessoa."
          );
        }

        throw error;
      }

      if (!data) {
        throw new Error(
          "O Supabase não retornou o perfil salvo."
        );
      }

      onComplete(
        data as CampfireProfile
      );
    } catch (error) {
      console.error(
        "Erro salvando perfil:",
        error
      );

      setErrorMessage(
        error instanceof Error
          ? error.message
          : "Não foi possível salvar seu perfil."
      );
    } finally {
      setSaving(false);
    }
  }

  /*
   * =========================================================
   * INDICADOR DO USERNAME
   * =========================================================
   */

  function renderUsernameStatus() {
    if (
      cleanUsername.length ===
      0
    ) {
      return (
        <span className="usernameHint">
          Escolha como seus amigos
          encontrarão você.
        </span>
      );
    }

    if (!usernameValid) {
      return (
        <span className="usernameInvalid">
          Use de 3 a 24 caracteres:
          letras, números ou _.
        </span>
      );
    }

    if (
      usernameState ===
      "checking"
    ) {
      return (
        <span className="usernameChecking">
          Verificando...
        </span>
      );
    }

    if (
      usernameState ===
      "available"
    ) {
      return (
        <span className="usernameAvailable">
          ✓ @{cleanUsername} está
          disponível
        </span>
      );
    }

    if (
      usernameState ===
      "taken"
    ) {
      return (
        <span className="usernameTaken">
          ✕ @{cleanUsername} já está
          em uso
        </span>
      );
    }

    if (
      usernameState ===
      "error"
    ) {
      return (
        <span className="usernameInvalid">
          Não foi possível verificar
          agora.
        </span>
      );
    }

    return null;
  }

  /*
   * =========================================================
   * AVATAR
   * =========================================================
   */

  const avatar =
    profile.avatar_url ||
    googleAvatar;

  const avatarLetter =
    (
      displayName ||
      cleanUsername ||
      "C"
    )
      .charAt(0)
      .toUpperCase();

  /*
   * =========================================================
   * RENDER
   * =========================================================
   */

  return (
    <div className="profileSetupPage">
      <div className="profileSetupGlow profileGlowOne" />
      <div className="profileSetupGlow profileGlowTwo" />

      <div className="profileSetupCard">
        <div className="profileSetupLogo">
          🔥
        </div>

        <h1>
          Bem-vindo ao Campfire
        </h1>

        <p className="profileIntro">
          Antes de continuar,
          escolha como seus amigos
          verão e encontrarão você.
        </p>

        <div className="profilePreview">
          {avatar ? (
            <img
              src={avatar}
              alt="Avatar"
              className="profileAvatar"
            />
          ) : (
            <div className="profileAvatarFallback">
              {avatarLetter}
            </div>
          )}

          <div>
            <strong>
              {displayName ||
                "Seu nome"}
            </strong>

            <small>
              @
              {cleanUsername ||
                "username"}
            </small>
          </div>
        </div>

        <div className="profileField">
          <label>
            Username
          </label>

          <div className="usernameInputWrapper">
            <span>
              @
            </span>

            <input
              value={username}
              maxLength={24}
              autoFocus
              spellCheck={false}
              placeholder="blackbeard"
              onChange={(event) => {
                /*
                 * Username do Campfire
                 * sempre em minúsculas.
                 */
                const value =
                  event.target.value
                    .toLowerCase()
                    .replace(
                      /[^a-z0-9_]/g,
                      ""
                    );

                setUsername(
                  value
                );

                setErrorMessage(
                  ""
                );
              }}
            />
          </div>

          <div className="usernameStatus">
            {renderUsernameStatus()}
          </div>
        </div>

        <div className="profileField">
          <label>
            Nome de exibição
          </label>

          <input
            className="displayNameInput"
            value={displayName}
            maxLength={40}
            placeholder="BlackBeard"
            onChange={(event) => {
              setDisplayName(
                event.target.value
              );
            }}
          />

          <small className="fieldDescription">
            Esse é o nome que aparecerá
            nas conversas.
          </small>
        </div>

        <button
          className="profileContinueButton"
          disabled={
            !usernameValid ||
            usernameState ===
              "taken" ||
            usernameState ===
              "checking" ||
            saving
          }
          onClick={saveProfile}
        >
          {saving
            ? "Salvando..."
            : "🔥 Entrar no Campfire"}
        </button>

        {errorMessage && (
          <div className="profileError">
            {errorMessage}
          </div>
        )}

        <div className="profileEmail">
          Conectado como{" "}
          <strong>
            {session.user.email}
          </strong>
        </div>
      </div>
    </div>
  );
}

export default ProfileSetup;