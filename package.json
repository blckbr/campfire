{
  "name": "campfire-black-piano",
  "productName": "Campfire",
  "private": true,
  "version": "1.1.0",
  "description": "Campfire — chat, voz, vídeo, compartilhamento de tela e Watch Together",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev": "npm run electron:dev",
    "typecheck": "tsc --noEmit",
    "build:web": "npm run typecheck && vite build",
    "build": "npm run build:web",
    "test:unit": "node --test tests/*.test.mjs",
    "verify:source": "npm run test:unit && node --check electron/main.mjs && node --check electron/preload.cjs && node --check electron/screen-picker-preload.cjs && node --check scripts/dev.mjs",
    "verify": "npm run verify:source && npm run build:web",
    "dist": "npm run dist:win",
    "dist:portable": "npm run dist:win:portable",
    "electron:dev": "node scripts/dev.mjs",
    "build:campfireweb": "tsc --noEmit -p tsconfig.web.json && vite build --mode web",
    "dev:campfireweb": "vite --mode web --host 0.0.0.0",
    "test:campfireweb": "node --test tests/campfire-web-production.test.mjs",
    "dist:win": "npm run verify && electron-builder --win nsis --x64",
    "dist:win:portable": "npm run verify && electron-builder --win portable --x64",
    "dist:linux:rpm": "npm run verify && electron-builder --linux rpm --x64",
    "dist:linux:appimage": "npm run verify && electron-builder --linux AppImage --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "hls.js": "^1.6.19",
    "livekit-client": "2.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-rnnoise-wasm": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "build": {
    "appId": "com.devsaex.campfire",
    "productName": "Campfire",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "Campfire-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Campfire",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "public/campfire-icon.png",
        "to": "campfire-icon.png"
      }
    ],
    "portable": {
      "artifactName": "Campfire-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "rpm",
        "AppImage"
      ],
      "category": "Network",
      "icon": "public/campfire-icon.png",
      "artifactName": "Campfire-${version}-linux-${arch}.${ext}",
      "synopsis": "Campfire chat, voice, video and Watch Together",
      "maintainer": "Deivison Santos <blckbr@users.noreply.github.com>",
      "vendor": "Deivison Santos / @devsaex"
    },
    "rpm": {
      "packageCategory": "Applications/Internet",
      "packageName": "campfire"
    }
  },
  "author": {
    "name": "Deivison Santos (@devsaex)",
    "email": "blckbr@users.noreply.github.com",
    "url": "https://github.com/blckbr"
  },
  "homepage": "https://github.com/blckbr/campfire",
  "repository": {
    "type": "git",
    "url": "https://github.com/blckbr/campfire.git"
  }
}
